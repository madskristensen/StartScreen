<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\CodeCoverage.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.0.31902.203" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.0.64" />
    <ProjectReference Include="..\..\src\StartScreen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\src\VSCommandTable.vsct" LogicalName="VSCommandTable.vsct" />
    <EmbeddedResource Include="..\..\src\ToolWindows\StartScreenControl.xaml" LogicalName="StartScreenControl.xaml" />
    <EmbeddedResource Include="..\..\src\ToolWindows\StartScreenResources.xaml" LogicalName="StartScreenResources.xaml" />
    <EmbeddedResource Include="..\..\src\ToolWindows\Controls\DevHubPanel.xaml" LogicalName="DevHubPanel.xaml" />
    <EmbeddedResource Include="..\..\src\ToolWindows\Controls\NewsItemControl.xaml" LogicalName="NewsItemControl.xaml" />
    <EmbeddedResource Include="..\..\src\ToolWindows\Controls\YouTubeVideoControl.xaml" LogicalName="YouTubeVideoControl.xaml" />
    <EmbeddedResource Include="..\..\src\ToolWindows\Controls\MruItemControl.xaml" LogicalName="MruItemControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>

</Project>
