<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>
  <Include href="KnownImageIds.vsct"/>
  <Include href="VSGlobals.vsct"/>

  <Commands package="StartScreen">
    <Menus>
      <Menu guid="StartScreen" id="ClearRecentMenu" type="Context">
        <Strings>
          <CommandName>Clear Recent</CommandName>
        </Strings>
      </Menu>
      <Menu guid="StartScreen" id="CopilotSessionMenu" type="Context">
        <Strings>
          <CommandName>Copilot Session</CommandName>
        </Strings>
      </Menu>
      <Menu guid="StartScreen" id="DevHubWorkItemMenu" type="Context">
        <Strings><CommandName>Dev Hub Activity</CommandName></Strings>
      </Menu>
      <Menu guid="StartScreen" id="MruItemMenu" type="Context">
        <Strings><CommandName>Recent project</CommandName></Strings>
      </Menu>
      <Menu guid="StartScreen" id="MruWorktreesMenu" type="Menu" priority="0x0450">
        <Parent guid="StartScreen" id="MruOpenActions"/>
        <Icon guid="ImageCatalogGuid" id="BranchFork"/><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Open Worktree</ButtonText><CommandName>Open Worktree</CommandName></Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="StartScreen" id="StartScreenGroup" priority="0x0300">
        <Parent guid="VSMainMenu" id="File"/>
      </Group>
      <Group guid="StartScreen" id="ClearRecentGroup" priority="0x0100">
        <Parent guid="StartScreen" id="ClearRecentMenu"/>
      </Group>
      <Group guid="StartScreen" id="CopilotSessionGroup" priority="0x0100">
        <Parent guid="StartScreen" id="CopilotSessionMenu"/>
      </Group>
      <Group guid="StartScreen" id="DevHubWorkItemActions" priority="0x0100">
        <Parent guid="StartScreen" id="DevHubWorkItemMenu"/>
      </Group>
      <Group guid="StartScreen" id="DevHubWorkItemCopy" priority="0x0200">
        <Parent guid="StartScreen" id="DevHubWorkItemMenu"/>
      </Group>
      <Group guid="StartScreen" id="DevHubWorkItemPreferences" priority="0x0180">
        <Parent guid="StartScreen" id="DevHubWorkItemMenu"/>
      </Group>
      <Group guid="StartScreen" id="DevHubWorkItemScope" priority="0x0300">
        <Parent guid="StartScreen" id="DevHubWorkItemMenu"/>
      </Group>
      <Group guid="StartScreen" id="MruOpenActions" priority="0x0100"><Parent guid="StartScreen" id="MruItemMenu"/></Group>
      <Group guid="StartScreen" id="MruTagActions" priority="0x0200"><Parent guid="StartScreen" id="MruItemMenu"/></Group>
      <Group guid="StartScreen" id="MruItemActions" priority="0x0300"><Parent guid="StartScreen" id="MruItemMenu"/></Group>
      <Group guid="StartScreen" id="MruWorktreeActions" priority="0x0100"><Parent guid="StartScreen" id="MruWorktreesMenu"/></Group>
      <Group guid="StartScreen" id="MruWorktreeMaintenance" priority="0x0200"><Parent guid="StartScreen" id="MruWorktreesMenu"/></Group>
    </Groups>

    <!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
    <Buttons>
      <Button guid="StartScreen" id="MruPruneWorktrees" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="MruWorktreeMaintenance"/>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Prune deleted worktrees...</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruNewChat" priority="0x0480" type="Button">
        <Parent guid="StartScreen" id="MruOpenActions"/>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>New Chat Session</ButtonText></Strings>
      </Button>
      <!-- Reserve 0x2000-0x2FFF for the dynamic worktree list. -->
      <Button guid="StartScreen" id="MruOpenWorktree" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="MruWorktreeActions"/>
        <CommandFlag>DynamicItemStart</CommandFlag><CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>Open worktree</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruOpen" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="MruOpenActions"/><Icon guid="ImageCatalogGuid" id="Open"/><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Open</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruOpenNewInstance" priority="0x0200" type="Button">
        <Parent guid="StartScreen" id="MruOpenActions"/>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Open in New Instance</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruOpenFolder" priority="0x0300" type="Button">
        <Parent guid="StartScreen" id="MruOpenActions"/>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Open Containing Folder</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruOpenTerminal" priority="0x0400" type="Button">
        <Parent guid="StartScreen" id="MruOpenActions"/>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Open in Terminal</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruGitPull" priority="0x0500" type="Button">
        <Parent guid="StartScreen" id="MruOpenActions"/>
        <Icon guid="ImageCatalogGuid" id="Pull"/><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag><Strings><ButtonText>Git Pull</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruDeleteChats" priority="0x0600" type="Button">
        <Parent guid="StartScreen" id="MruOpenActions"/><CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Delete Copilot Chat Sessions</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruAddTags" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="MruTagActions"/><CommandFlag>TextChanges</CommandFlag><Strings><ButtonText>Add tags...</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruRemoveTags" priority="0x0200" type="Button">
        <Parent guid="StartScreen" id="MruTagActions"/><CommandFlag>TextChanges</CommandFlag><Strings><ButtonText>Remove tags...</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruCopyPath" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="MruItemActions"/><Icon guid="ImageCatalogGuid" id="Copy"/><CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag><CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Copy Path</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruPin" priority="0x0200" type="Button">
        <Parent guid="StartScreen" id="MruItemActions"/><CommandFlag>TextChanges</CommandFlag><Strings><ButtonText>Pin</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="MruRemove" priority="0x0300" type="Button">
        <Parent guid="StartScreen" id="MruItemActions"/><Strings><ButtonText>Remove from List</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubOpenInBrowser" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemActions"/>
        <Icon guid="ImageCatalogGuid" id="BrowserLink"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>Open in Browser</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubReviewInVisualStudio" priority="0x0050" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemActions"/>
        <Icon guid="ImageCatalogGuid" id="PullRequest"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Review in Visual Studio</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubRequestCopilotReview" priority="0x0300" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemActions"/>
        <Icon guid="ImageCatalogGuid" id="GitHubCopilot"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Request Copilot Review</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubFixWithCopilot" priority="0x0200" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemActions"/>
        <Icon guid="ImageCatalogGuid" id="GitHubCopilot"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>Fix with Copilot</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubNewCopilotChat" priority="0x0210" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemActions"/>
        <Icon guid="ImageCatalogGuid" id="GitHubCopilot"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Start new Copilot chat</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubCopyUrl" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemCopy"/>
        <Icon guid="ImageCatalogGuid" id="Copy"/>
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings><ButtonText>Copy URL</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubPinItem" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemPreferences"/>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>Pin to Attention</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubSnoozeItem" priority="0x0200" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemPreferences"/>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>Snooze for 1 hour</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubSnoozeItemDay" priority="0x0300" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemPreferences"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Snooze for 1 day</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubScopeToRepo" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemScope"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>Scope to repository</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="DevHubShowAllRepos" priority="0x0200" type="Button">
        <Parent guid="StartScreen" id="DevHubWorkItemScope"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Show all repositories</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="OpenCopilotInVisualStudio" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="CopilotSessionGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Open in Visual Studio</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="OpenCopilotInCli" priority="0x0300" type="Button">
        <Parent guid="StartScreen" id="CopilotSessionGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>TextChanges</CommandFlag>
        <Strings><ButtonText>Open in CLI</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="OpenCopilotOnGitHub" priority="0x0400" type="Button">
        <Parent guid="StartScreen" id="CopilotSessionGroup"/>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Open on GitHub</ButtonText></Strings>
      </Button>
      <Button guid="StartScreen" id="ShowStartScreenCommand" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="StartScreenGroup" />
        <Icon guid="ImageCatalogGuid" id="Home" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Start Screen</ButtonText>
          <LocCanonicalName>.StartScreen.ShowStartScreen</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="StartScreen" id="ClearAllRecentCommand" priority="0x0100" type="Button">
        <Parent guid="StartScreen" id="ClearRecentGroup" />
        <Strings>
          <ButtonText>Clear All</ButtonText>
        </Strings>
      </Button>
      <Button guid="StartScreen" id="ClearAllButPinnedCommand" priority="0x0200" type="Button">
        <Parent guid="StartScreen" id="ClearRecentGroup" />
        <Strings>
          <ButtonText>Clear All But Pinned</ButtonText>
        </Strings>
      </Button>
      <Button guid="StartScreen" id="ClearMissingRecentCommand" priority="0x0300" type="Button">
        <Parent guid="StartScreen" id="ClearRecentGroup" />
        <Strings>
          <ButtonText>Clear Missing</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <CommandPlacement guid="StartScreen" id="ShowStartScreenCommand" priority="0x0001">
      <Parent guid="guidSHLMainMenu" id="IDG_VS_TOOLSB_SAVEOPEN" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <KeyBinding guid="StartScreen" id="ShowStartScreenCommand" editor="guidVSStd97" mod1="Control Shift Alt" key1="VK_BACK" />
  </KeyBindings>

