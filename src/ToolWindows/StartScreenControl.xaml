<UserControl x:Class="StartScreen.ToolWindows.StartScreenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StartScreen.ToolWindows"
             xmlns:controls="clr-namespace:StartScreen.ToolWindows.Controls"
             xmlns:helpers="clr-namespace:StartScreen.Helpers"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1400"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AllowDrop="True"
             DragOver="UserControl_DragOver"
             Drop="UserControl_Drop"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             GotKeyboardFocus="UserControl_GotKeyboardFocus">

    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:BoolToHiddenVisibilityConverter x:Key="BoolToHiddenVisibilityConverter"/>
        <local:RefreshingToOpacityConverter x:Key="RefreshingToOpacityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <local:ColumnCountToWidthConverter x:Key="ColumnCountToWidthConverter"/>
        <CollectionViewSource x:Key="GroupedMruItemsView"
                              Source="{Binding VisibleMruItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="DisplayGroup"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Static shell:VsResourceKeys.ThemedDialogButtonStyleKey}}">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12 6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ScrollTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DiscreetVerticalScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Margin="2 0" CornerRadius="3" Opacity="0.35"
                                                        Background="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab item style for News sub-tabs (Blogs / Videos) -->
        <Style x:Key="NewsTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0 0 0 2"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search TextBox Style -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="8 0"
                                SnapsToDevicePixels="True">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <imaging:CrispImage Grid.Column="0"
                                                    Moniker="{x:Static catalog:KnownMonikers.Search}"
                                                    Width="16" Height="16"
                                                    Margin="0 0 6 0"
                                                    VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxFocusedBackgroundBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxFocusedBorderBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="24 20 24 20" Padding="0 0 0 18" BorderThickness="0 0 0 1"
                BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                <WrapPanel x:Name="ActionBar"
                            PreviewKeyDown="ActionBar_PreviewKeyDown">
                    <Button Click="NewProjectButton_Click" Style="{StaticResource ActionButtonStyle}">
                        <TextBlock Text="New Project"/>
                    </Button>
                    <Button Click="OpenProjectButton_Click" Style="{StaticResource ActionButtonStyle}" Margin="4 0 0 0">
                        <TextBlock Text="Open Project"/>
                    </Button>
                    <Button Click="OpenFolderButton_Click" Style="{StaticResource ActionButtonStyle}" Margin="4 0 0 0">
                        <TextBlock Text="Open Folder"/>
                    </Button>
                    <Button Click="CloneRepoButton_Click" Style="{StaticResource ActionButtonStyle}" Margin="4 0 0 0">
                        <TextBlock Text="Clone Repo"/>
                    </Button>
                    <Button x:Name="AttachToProcessButton"
                            Click="AttachToProcessButton_Click"
                            PreviewMouseLeftButtonDown="AttachToProcessButton_PreviewMouseLeftButtonDown"
                            Style="{StaticResource ActionButtonStyle}"
                            Padding="12 0 0 0"
                            HorizontalContentAlignment="Stretch"
                            Margin="4 0 0 0"
                            ToolTip="Attach to Process">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AttachToProcessMenu">
                                <MenuItem Header="Reattach to Process"
                                          InputGestureText="Shift+Alt+P"
                                          Click="ReattachToProcessMenuItem_Click">
                                    <MenuItem.Icon>
                                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Process}" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Attach" VerticalAlignment="Center" Margin="0 0 12 0"/>
                            <Border Grid.Column="1" BorderThickness="1 0 0 0" Padding="0 12"
                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path Data="M0,0 L6,0 L3,4 z" Width="6" Height="4" Stretch="Fill"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0" ToolTip="{Binding ServiceHealthDetails}"
                                Visibility="{Binding HasServiceHealthStatus, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                        <imaging:CrispImage Width="12" Height="12" Margin="0 0 6 0" VerticalAlignment="Center">
                            <imaging:CrispImage.Style>
                                <Style TargetType="imaging:CrispImage">
                                    <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusInformation}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceHealthy}" Value="True">
                                            <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusOK}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsServiceHealthy}" Value="False">
                                            <Setter Property="Moniker" Value="{x:Static catalog:KnownMonikers.StatusWarning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </imaging:CrispImage.Style>
                        </imaging:CrispImage>
                        <TextBlock FontSize="12">
                            <Hyperlink Click="ServiceStatusLink_Click" Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                <Run Text="{Binding ServiceHealthText, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16 0 0 0" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Margin="0 0 16 0" VerticalAlignment="Center"
                                   Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
                            <Hyperlink Click="UpdateNowButton_Click" Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                <Run Text="{Binding UpdateAvailableText, Mode=OneWay}"/>
                            </Hyperlink>
                        </TextBlock>
                        <Button x:Name="UnifiedRefreshButton" Click="UnifiedRefreshButton_Click" ToolTip="Refresh Dev Hub, news, and videos">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8 6"/>
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRefreshingAny}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Refresh}" Width="16" Height="16" Margin="0 0 6 0"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StartScreenSettingsButton" Click="StartScreenSettingsButton_Click"
                                Style="{StaticResource IconButtonStyle}" Margin="4 0 0 0" VerticalAlignment="Center"
                                Height="{Binding ActualHeight, ElementName=UnifiedRefreshButton}"
                                Width="{Binding ActualHeight, ElementName=UnifiedRefreshButton}"
                                ToolTip="Start Screen settings" AutomationProperties.Name="Start Screen settings">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Settings}" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="LastRefreshText" Text="{Binding UnifiedRefreshStatus}" FontSize="11" Opacity="0.65"
                               HorizontalAlignment="Right" Margin="0 10 0 0"/>
                </StackPanel>
            </Grid>
        </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="360" MinWidth="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="RightColumn" Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="24 0 20 24">
                <!-- Search Box -->
                <Grid DockPanel.Dock="Top" Margin="0 0 0 8" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                            Grid.Column="0"
                            Height="32"
                            Style="{StaticResource SearchBoxStyle}"
                            TextChanged="SearchBox_TextChanged"
                            PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <TextBlock Grid.Column="0"
                              Text="Search recent..."
                              Margin="32 0 0 0"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxTextBrushKey}}"
                               Opacity="0.6"
                              Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Border Grid.Column="1"
                            Width="1"
                            Margin="12 0"
                            Background="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarBorderBrushKey}}"/>
                    <Button x:Name="ClearRecentButton"
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            Padding="0"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ClearRecentButton_Click"
                            ToolTip="Recent items options"
                            AutomationProperties.Name="Recent items options">
                        <TextBlock Text="..."
                                  Margin="0 -5 0 0"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="Select to preview / Double-click or Enter to open"
                           FontSize="11" Opacity="0.65" Margin="0 0 0 10" TextWrapping="Wrap"/>
                <!-- MRU Section -->
                <Grid>
                    <ListBox x:Name="MruPanel"
                             ItemsSource="{Binding Source={StaticResource GroupedMruItemsView}}"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="False"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             AllowDrop="True"
                             DragOver="PinnedItems_DragOver"
                             Drop="PinnedItems_Drop"
                             DragLeave="PinnedItems_DragLeave"
                             PreviewMouseLeftButtonDown="PinnedItems_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="PinnedItems_PreviewMouseMove">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DiscreetVerticalScrollBarStyle}">
                                <Setter Property="Width" Value="8"/>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.7"
                                                   Margin="0 12 0 4"
                                                   Focusable="False"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0 0 12 0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:MruItemControl
                                    SelectionRequested="MruItemControl_SelectionRequested"
                                    RepositorySummaryRequested="MruItemControl_RepositorySummaryRequested"
                                    RepositoryReviewsRequested="MruItemControl_RepositoryReviewsRequested"
                                    PinToggleRequested="MruItemControl_PinToggleRequested"
                                    RemoveRequested="MruItemControl_RemoveRequested"
                                    FocusSearchBoxRequested="MruItemControl_FocusSearchBoxRequested"
                                    FocusDevHubRequested="MruItemControl_FocusDevHubRequested"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No matching projects or solutions found."
                               Opacity="0.5"
                               FontSize="13"
                               Margin="0 16 0 0"
                               VerticalAlignment="Top"
                               Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                </DockPanel>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                              BorderThickness="1 0 0 0" Cursor="SizeWE" Focusable="False" DragCompleted="GridSplitter_DragCompleted"/>
                <ScrollViewer x:Name="PageScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DiscreetVerticalScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                <Border x:Name="RightPaneBorder" SizeChanged="RightPaneBorder_SizeChanged">
                    <DockPanel x:Name="NewsPanel" Margin="24 0 24 24" Focusable="False">
                        <ScrollViewer x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" Style="{x:Null}" PreviewMouseWheel="ContentScroll_PreviewMouseWheel" ScrollChanged="ContentScroll_ScrollChanged">
                            <Grid x:Name="ContentLayout" Width="{Binding ActualWidth, ElementName=ContentScroll}" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="DevHubColumn" Width="560" MaxWidth="560"/>
                                    <ColumnDefinition x:Name="NewsColumn" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="ActivitySectionHeader"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="WorkSectionHeader" Grid.Row="0" Grid.Column="0" Margin="0 0 24 12"
                                            Visibility="{Binding Visibility, ElementName=DevHubPanelControl}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="All repositories" Click="ClearWorkspaceSelection_Click"
                                                Style="{StaticResource ActionButtonStyle}" MinWidth="0" MinHeight="24" Padding="6 2"
                                                Visibility="{Binding HasSelectedMruItem, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock x:Name="WorkHeadingLine" FontSize="20" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                            <InlineUIContainer BaselineAlignment="Baseline">
                                                <TextBlock Text="{Binding WorkSectionTitle}" MaxWidth="240"
                                                           FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </InlineUIContainer>
                                            <InlineUIContainer BaselineAlignment="Baseline">
                                                <Border x:Name="CopilotActivityStatusGap" Width="12" Height="0"
                                                        Tag="{Binding CopilotActivityStatus, ElementName=DevHubPanelControl, Mode=OneWay}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="Tag" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </InlineUIContainer>
                                            <Run x:Name="CopilotActivityStatusText" BaselineAlignment="Baseline" FontWeight="Normal"
                                                 Text="{Binding CopilotActivityStatus, ElementName=DevHubPanelControl, Mode=OneWay}"
                                                 FontSize="{Binding FontSize, ElementName=DevHubPanelControl, Mode=OneWay}"
                                                 ToolTip="{Binding CopilotActivityStatus, ElementName=DevHubPanelControl, Mode=OneWay}">
                                                <Run.Foreground>
                                                    <SolidColorBrush Color="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextColorKey}}" Opacity="0.7"/>
                                                </Run.Foreground>
                                            </Run>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                                <ProgressBar Grid.Row="0" Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" IsIndeterminate="True"
                                             BorderThickness="0" Background="Transparent" Margin="0 -8 0 0"
                                             Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                                             Visibility="{Binding IsRefreshingAny, Converter={StaticResource BoolToHiddenVisibilityConverter}}"/>
                                <controls:DevHubPanel x:Name="DevHubPanelControl" Grid.Row="1" Grid.Column="0" Margin="0 0 24 0" VerticalAlignment="Top"
                                                      RefreshRequested="DevHubPanel_RefreshRequested" LastRefreshChanged="DevHubPanel_LastRefreshChanged"
                                                      ConnectAccountRequested="DevHubPanel_ConnectAccountRequested" ScopeToRepoRequested="DevHubPanel_ScopeToRepoRequested"
                                                      FocusMruRequested="DevHubPanel_FocusMruRequested" FocusNewsRequested="DevHubPanel_FocusNewsRequested"/>
                                <Grid x:Name="NewsColumnPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="ActivitySectionHeader"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0 0 0 12">
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12 0 0 0">
                                            <Hyperlink Click="NewsFeedsSettingsLink_Click" Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">Feeds</Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="News &amp; updates" FontSize="20" FontWeight="SemiBold"/>
                                    </DockPanel>
                            <TabControl Grid.Row="1"
                                        x:Name="NewsTabs"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        SelectionChanged="NewsTabs_SelectionChanged">
                                <!-- Blogs Tab -->
                                <TabItem x:Name="BlogsTab" Style="{StaticResource NewsTabItemStyle}">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Blogs"/>
                                            <Ellipse Width="6" Height="6" Margin="4 0 0 0"
                                                     Fill="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}" VerticalAlignment="Center"
                                                     ToolTip="New blog posts since you last viewed this tab"
                                                     Visibility="{Binding HasNewBlogs, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <StackPanel Margin="0 24 0 0">
                                        <TextBlock Text="News feeds are currently unavailable. Use Refresh at the top to try again."
                                                   TextWrapping="Wrap"
                                                   Opacity="0.6"
                                                   Margin="0 0 0 8"
                                                   Visibility="{Binding IsNewsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Pinned News Articles -->
                                        <TextBlock Text="Pinned"
                                                  FontSize="13"
                                                  FontWeight="SemiBold"
                                                  Opacity="0.7"
                                                  Margin="0 0 0 4"
                                                  Focusable="False"
                                                  Visibility="{Binding PinnedNewsPosts.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding PinnedNewsPosts}" Focusable="False"
                                                      Opacity="{Binding IsRefreshingNews, Converter={StaticResource RefreshingToOpacityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding NewsColumnCount}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:NewsItemControl Margin="0 0 12 12" MaxWidth="360" HorizontalAlignment="Left"
                                                                              PinToggleRequested="NewsItemControl_PinToggleRequested"
                                                                              FocusDevHubRequested="NewsItemControl_FocusDevHubRequested"
                                                                              FocusYouTubeRequested="NewsItemControl_FocusYouTubeRequested"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- News Cards -->
                                        <ItemsControl ItemsSource="{Binding NewsPosts}" Focusable="False"
                                                      HorizontalAlignment="Stretch"
                                                      Opacity="{Binding IsRefreshingNews, Converter={StaticResource RefreshingToOpacityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding NewsColumnCount}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:NewsItemControl Margin="0 0 12 12" MaxWidth="360" HorizontalAlignment="Left"
                                                                              PinToggleRequested="NewsItemControl_PinToggleRequested"
                                                                              FocusDevHubRequested="NewsItemControl_FocusDevHubRequested"
                                                                              FocusYouTubeRequested="NewsItemControl_FocusYouTubeRequested"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </TabItem>

                                <!-- Videos Tab -->
                                <TabItem x:Name="VideosTab" Style="{StaticResource NewsTabItemStyle}">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Videos"/>
                                            <Ellipse Width="6" Height="6" Margin="4 0 0 0"
                                                     Fill="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}" VerticalAlignment="Center"
                                                     ToolTip="New videos since you last viewed this tab"
                                                     Visibility="{Binding HasNewVideos, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <StackPanel Margin="0 24 0 0">
                                        <TextBlock Text="YouTube feed is currently unavailable. Use Refresh at the top to try again."
                                                   TextWrapping="Wrap"
                                                   Opacity="0.6"
                                                   Margin="0 0 0 8"
                                                   Visibility="{Binding IsYouTubeUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding YouTubeVideos}" Focusable="False"
                                                      HorizontalAlignment="Stretch"
                                                      Opacity="{Binding IsRefreshingYouTube, Converter={StaticResource RefreshingToOpacityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding YouTubeColumnCount}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:YouTubeVideoControl Margin="0 0 12 16" MaxWidth="360" HorizontalAlignment="Left"
                                                                                   FocusNewsRequested="YouTubeVideoControl_FocusNewsRequested"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </TabItem>

                                <!-- Release Notes Tab -->
                                <TabItem x:Name="ReleaseNotesTab" Style="{StaticResource NewsTabItemStyle}">
                                    <TabItem.Header>
                                        <TextBlock Text="Release notes"/>
                                    </TabItem.Header>
                                    <StackPanel Margin="0 24 0 0">
                                        <TextBlock TextWrapping="Wrap">
                                            <Hyperlink x:Name="ReleaseNotesLink" Click="ReleaseNotesLink_Click"
                                                       Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                                View release notes for <Run Text="{Binding DiscoverySectionVersion, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </ScrollViewer>
            </Grid>
        <CheckBox Grid.Row="2" Content="Solutions only" IsChecked="{Binding ShowSolutionsOnly, Mode=TwoWay}"
                  ToolTip="Show only solutions in Recent. Pinned items are always included."
                  HorizontalAlignment="Left" Margin="24 8 0 16"/>
        <ScrollBar x:Name="ContentHorizontalScrollbar" Grid.Row="3" Orientation="Horizontal" Visibility="Collapsed"
                   Minimum="0" SmallChange="24" LargeChange="120" ValueChanged="ContentHorizontalScrollbar_ValueChanged"/>
        <Popup x:Name="StartScreenSettingsPopup"
               PlacementTarget="{Binding ElementName=StartScreenSettingsButton}"
               Placement="Bottom"
               HorizontalOffset="-220"
               VerticalOffset="2"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarBorderBrushKey}}"
                    BorderThickness="1"
                    Padding="12">
                <StackPanel MinWidth="260">
                    <TextBlock Text="Start Screen settings"
                               FontWeight="SemiBold"
                               Margin="0 0 0 8"/>

                    <CheckBox x:Name="ShowDevHubCheckBox"
                              Content="Show Dev Hub"
                              Margin="0 6 0 0"
                              Checked="ShowDevHubCheckBox_Changed"
                              Unchecked="ShowDevHubCheckBox_Changed"/>

                    <Border BorderThickness="0 0 0 1"
                            BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarBorderBrushKey}}"
                            Margin="0 10 0 8"/>

                    <TextBlock x:Name="DevHubSettingsLinkText" Margin="0 0 0 4">
                        <Hyperlink Click="DevHubSettingsLink_Click"
                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                            Dev Hub accounts and search query...
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock>
                        <Hyperlink Click="NewsFeedsSettingsLink_Click"
                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                            Customize news feeds...
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
