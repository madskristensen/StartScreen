    <UserControl x:Class="StartScreen.ToolWindows.Controls.DevHubPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:controls="clr-namespace:StartScreen.ToolWindows.Controls"
             xmlns:helpers="clr-namespace:StartScreen.Helpers"
             toolkit:Themes.UseVsTheme="True"
             Background="Transparent"
             Focusable="True"
             IsTabStop="True"
             GotFocus="DevHubPanel_GotFocus"
             Loaded="BeginWorkspaceVisit"
             Unloaded="CopilotUnloaded"
             IsVisibleChanged="CopilotVisibilityChanged"
             PreviewKeyDown="DevHubPanel_PreviewKeyDown"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="520">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <controls:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <controls:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
        <controls:HexColorToForegroundConverter x:Key="HexColorToForegroundConverter"/>
        <controls:CiStatusToMonikerConverter x:Key="CiStatusToMonikerConverter"/>
        <Style x:Key="PullRequestStatusStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusCategory}" Value="Muted">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <Setter Property="Opacity" Value="0.65"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusCategory}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:ProgressBarColors.IndicatorFillWarningBrushKey}}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusCategory}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:ProgressBarColors.IndicatorFillCriticalBrushKey}}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusCategory}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonDocumentColors.StatusBannerSuccessBorderTextBrushKey}}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PullRequestActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="PullRequestActionsTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Click="OpenPullRequestInBrowser_Click" Style="{StaticResource PullRequestActionButtonStyle}"
                        Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                        ToolTip="Open in browser" AutomationProperties.Name="Open pull request in browser"
                        AutomationProperties.HelpText="{Binding Title}">
                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Web}" Width="16" Height="16"/>
                </Button>
                <Button Click="OpenPullRequestInVisualStudio_Click" Style="{StaticResource PullRequestActionButtonStyle}"
                        Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" Margin="4 0 0 0"
                        ToolTip="Open in Visual Studio" AutomationProperties.Name="Open pull request in Visual Studio"
                        AutomationProperties.HelpText="{Binding Title}">
                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.PullRequest}" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PullRequestMetadataTemplate">
            <DockPanel>
                <ContentControl DockPanel.Dock="Right" Content="{Binding}" Focusable="False" Margin="8 0 0 0"
                                ContentTemplate="{StaticResource PullRequestActionsTemplate}"/>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="9" Padding="7 2" Margin="0 0 8 2" BorderThickness="1"
                            Background="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                            BorderBrush="{Binding Foreground, ElementName=PullRequestStatus}">
                        <TextBlock x:Name="PullRequestStatus" Text="{Binding StatusText}" Style="{StaticResource PullRequestStatusStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding AuthorText}" FontSize="11" Opacity="0.65" Margin="0 2 0 2" Padding="0 0 8 0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding AuthorText}"
                               MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AuthorText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ActivityDateText}" FontSize="11" Opacity="0.65" Margin="0 2 0 2"
                               VerticalAlignment="Center" ToolTip="{Binding ActivityDateToolTip}"/>
                </WrapPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="RepositoryItemMetadataTemplate">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="OpenPullRequestInBrowser_Click"
                        Style="{StaticResource PullRequestActionButtonStyle}" Width="24" Height="24" Margin="8 0 0 0"
                        ToolTip="Open in browser" AutomationProperties.Name="Open activity in browser"
                        AutomationProperties.HelpText="{Binding Title}">
                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Web}" Width="16" Height="16"/>
                </Button>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="9" Padding="7 2" Margin="0 0 8 2" BorderThickness="1"
                            Background="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                            BorderBrush="{Binding Foreground, ElementName=RepositoryItemStatus}"
                            Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock x:Name="RepositoryItemStatus" Text="{Binding StatusText}" Style="{StaticResource PullRequestStatusStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding ActivityDateText}" FontSize="11" Opacity="0.65" Margin="0 2 0 2"
                               VerticalAlignment="Center" ToolTip="{Binding ActivityDateToolTip}"/>
                </WrapPanel>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="WorkItemTemplate">
            <Border x:Name="WorkItemBorder" Padding="8 10" Margin="0 0 0 4" CornerRadius="4" Focusable="True"
                    Cursor="Hand" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding ActionText}"
                    MouseUp="WorkItem_MouseUp" Loaded="DevHubItemBorder_Loaded" ToolTip="{Binding StatusDetails}">
                <Border.ContextMenu>
                    <ContextMenu Opened="DevHubContextMenu_Opened">
                        <MenuItem Header="Open in Browser" Click="OpenInBrowserMenuItem_Click" InputGestureText="Enter"/>
                        <Separator/>
                        <MenuItem Header="Copy URL" Click="CopyUrlMenuItem_Click" InputGestureText="Ctrl+C"/>
                        <Separator/>
                        <MenuItem Header="{Binding RepoIdentifier.Repo}" HeaderStringFormat="Scope to {0}" Click="ScopeToRepoMenuItem_Click"/>
                        <MenuItem Header="Show all repositories" Click="ClearFilter_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border x:Name="AssignmentBanner" BorderThickness="3 0 0 0" Padding="8 4" Margin="0 0 0 6"
                            BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                            Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                            Visibility="{Binding IsAssignedToCurrentUser, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="This issue or task is currently assigned to you.">
                        <TextBlock Text="Assigned to you" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
                    </Border>
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Opacity="0.65" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCopilot}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0 3 0 5"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCopilot}" Value="True">
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="Margin" Value="0 0 0 6"/>
                                        <Setter Property="ToolTip" Value="{Binding Title}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel x:Name="CopilotMetadata" Orientation="Horizontal"
                                Visibility="{Binding IsCopilot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <imaging:CrispImage x:Name="CopilotActivityIcon" Width="16" Height="16" Margin="0 0 6 0" VerticalAlignment="Center"
                                            Moniker="{x:Static helpers:CopilotMonikers.GitHubCopilot}"
                                            Visibility="{Binding IsCopilot, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CopilotStatus}" FontWeight="Bold" FontSize="10" Margin="0 0 6 0"
                                   VerticalAlignment="Center" ToolTip="{Binding CopilotStatusDetails}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CopilotStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CopilotStatus}" Value="Running">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CopilotStatus}" Value="Waiting">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:ProgressBarColors.IndicatorFillWarningBrushKey}}"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ActivityText}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"
                                   ToolTip="{Binding ActivityDateToolTip}"/>
                    </StackPanel>
                    <ContentControl Content="{Binding}" Focusable="False"
                                    Visibility="{Binding IsRepositoryItem, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource PullRequestMetadataTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPullRequest}" Value="False">
                                        <Setter Property="ContentTemplate" Value="{StaticResource RepositoryItemMetadataTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <TextBlock Text="{Binding BranchDisplayText}" FontSize="10.5" Opacity="0.5" Margin="0 2 0 0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding BranchDisplayText}"
                               Visibility="{Binding BranchDisplayText, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <TextBlock Text="{Binding NextActionText}" FontSize="11" Margin="0 2 0 0" TextWrapping="Wrap"
                               Visibility="{Binding NextActionText, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <ItemsControl ItemsSource="{Binding Labels}" Margin="0 4 0 0" Focusable="False">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Labels.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.65" Margin="0 0 10 2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCopilot}" Value="True">
                    <Setter TargetName="WorkItemBorder" Property="ContextMenu" Value="{x:Null}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="ActivityFilterStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0 0 6 6"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="FilterBorder" CornerRadius="11" Padding="8 3" BorderThickness="1"
                                Background="Transparent" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background"
                                        Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterBorder" Property="BorderBrush"
                                        Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <GroupStyle x:Key="WorkItemGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8 12 0 6"/>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
        <!-- Hover style for list item borders -->
        <Style x:Key="HoverItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel>
        <!-- Settings panel (toggled by gear button) -->
        <Border x:Name="SettingsPanel" Visibility="Collapsed"
                Margin="0 0 0 8"
                Padding="16"
                CornerRadius="4"
                Background="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarBorderBrushKey}}"
                TextElement.Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                BorderThickness="1">
            <Border.Resources>
                <Style TargetType="Expander">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Expander">
                                <StackPanel>
                                    <ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  HorizontalContentAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="HeaderBorder" Background="Transparent" BorderBrush="Transparent"
                                                        BorderThickness="1" CornerRadius="2" Padding="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 0 8" Margin="0 0 8 0"
                                                              VerticalAlignment="Center" StrokeThickness="1.5"
                                                              Stroke="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderBorder" Property="Background"
                                                                Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="HeaderBorder" Property="BorderBrush"
                                                                Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Button x:Name="CloseSettingsButton"
                        Click="CloseSettings_Click"
                        Style="{DynamicResource IconButtonStyle}"
                        Width="18" Height="18"
                        MinWidth="18" MinHeight="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 -2 -2 0"
                        Panel.ZIndex="10">
                    <Button.ToolTip>
                        <ToolTip Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolTipBrushKey}}"
                                 Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolTipTextBrushKey}}"
                                 BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolTipBorderBrushKey}}"
                                 BorderThickness="1"
                                 Padding="4">
                            <TextBlock Text="Close"/>
                        </ToolTip>
                    </Button.ToolTip>
                    <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Close}"
                                        Width="12" Height="12"/>
                </Button>
                <StackPanel>
                <!-- Accounts section -->
                <TextBlock Text="Accounts"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0 0 24 12"/>
                <StackPanel x:Name="ConnectedGitHubStatus" Margin="0 0 0 12">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="12 0 0 0">
                            <Hyperlink Click="GitHubSignOut_Click"
                                       Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                Sign out
                            </Hyperlink>
                        </TextBlock>
                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.StatusOK}"
                                            Width="12" Height="12"
                                            Margin="0 0 6 0"
                                            VerticalAlignment="Center"/>
                        <TextBlock x:Name="GitHubConnectedStatusText"
                                   Text="GitHub: connected"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <StackPanel x:Name="GitHubAccountSelectionPanel" Orientation="Horizontal" Margin="18 8 0 0">
                        <TextBlock Text="Use account"
                                   FontSize="10"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   Margin="0 0 6 0"/>
                        <ComboBox x:Name="GitHubAccountsComboBox"
                                  MinWidth="180"
                                  FontSize="11"
                                  Padding="4 2"
                                  SelectionChanged="GitHubAccountsComboBox_SelectionChanged"
                                  Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                                  Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                  BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SettingsConnectGitHubTextBlock" FontSize="11" Margin="0 0 0 4">
                    <Hyperlink Click="ConnectGitHub_Click"
                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                        Connect GitHub account...
                    </Hyperlink>
                    <Run Text=" "/>
                    <Hyperlink Click="ShowGitHubPatEntry_Click"
                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                        Enter token...
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="GitHubCredentialSettingsHelpTextBlock"
                           Visibility="Collapsed"
                           FontSize="10"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           Margin="0 0 0 4"
                           Text="Git Credential Manager did not provide a GitHub credential. Sign in with Git Credential Manager or enter a token."/>
                <StackPanel x:Name="GitHubPatEntryPanel" Visibility="Collapsed" Margin="0 0 0 4">
                    <TextBlock Text="GitHub personal access token"
                               FontSize="10"
                               Opacity="0.6"
                               Margin="0 0 0 3"/>
                    <Grid>
                        <PasswordBox x:Name="GitHubPatBox"
                                     FontSize="11"
                                     Padding="4 3"
                                     Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                                     Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                     BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                     KeyDown="GitHubPatBox_KeyDown"
                                     PasswordChanged="GitHubPatBox_PasswordChanged"/>
                        <TextBlock x:Name="GitHubPatPlaceholder"
                                   Text="Paste your PAT and press Enter"
                                   FontSize="11"
                                   Padding="6 4"
                                   Opacity="0.4"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock FontSize="10" Opacity="0.5" Margin="0 3 0 0" TextWrapping="Wrap">
                        <Run Text="Use this if Git Credential Manager is not installed or not signed in. "/>
                        <Hyperlink Click="OpenGitHubPatPage_Click"
                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                            Create a personal access token
                        </Hyperlink>
                        <Run Text=" with repository read access."/>
                    </TextBlock>
                </StackPanel>
                <!-- Azure DevOps section: cloud + on-prem servers -->
                <TextBlock x:Name="AdoAuthenticationHelpText" Visibility="Collapsed"
                           FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0 0 0 6"/>
                <ItemsControl x:Name="AdoServersList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <imaging:CrispImage Grid.Column="0"
                                                    Moniker="{Binding StatusMoniker}"
                                                    Width="12" Height="12"
                                                    Margin="0 0 6 0"
                                                    VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayText}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock FontSize="11" Margin="6 0 0 0"
                                               Visibility="{Binding SignInVisibility}">
                                        <Hyperlink Click="AdoServer_SignIn_Click" Tag="{Binding Host}"
                                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                            <Run Text="{Binding SignInText}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Margin="6 0 0 0"
                                               Visibility="{Binding ChangeVisibility}">
                                        <Hyperlink Click="AdoServer_SignIn_Click" Tag="{Binding Host}"
                                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                            Change
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Margin="6 0 0 0"
                                               Visibility="{Binding DisconnectVisibility}">
                                        <Hyperlink Click="AdoServer_Disconnect_Click" Tag="{Binding Host}"
                                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                            Disconnect
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Margin="6 0 0 0"
                                               Visibility="{Binding RemoveVisibility}">
                                        <Hyperlink Click="AdoServer_Remove_Click" Tag="{Binding Host}"
                                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                                            Remove
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander x:Name="AdoConnectionOptions" Header="Connection options" IsExpanded="False"
                          FontSize="11" Margin="0 4 0 0">
                    <StackPanel Margin="18 10 0 0">
                <TextBlock FontSize="11" Margin="0 0 0 10" TextWrapping="Wrap">
                    <Hyperlink Click="ConnectAdo_Click"
                               ToolTip="Use the account selected in Visual Studio's Azure Service Authentication settings. No PAT is required."
                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                        Use Visual Studio account (Entra ID)
                    </Hyperlink>
                    <Run Text=" or "/>
                    <Hyperlink Click="ShowCloudAdoPatEntry_Click"
                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                        use a PAT...
                    </Hyperlink>
                </TextBlock>

                <!-- PAT entry for an existing server (revealed when "Sign in" / "Change" is clicked) -->
                <StackPanel x:Name="AdoPatEntryPanel" Visibility="Collapsed" Margin="0 4 0 4">
                    <TextBlock x:Name="AdoPatHostLabel"
                               FontSize="10"
                               Opacity="0.6"
                               Margin="0 0 0 3"
                               Text="Azure DevOps personal access token"/>
                    <Grid>
                        <PasswordBox x:Name="AdoPatBox"
                                     FontSize="11"
                                     Padding="4 3"
                                     Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                                     Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                     BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                     KeyDown="AdoPatBox_KeyDown"
                                     PasswordChanged="AdoPatBox_PasswordChanged"/>
                        <TextBlock x:Name="AdoPatPlaceholder"
                                   Text="Paste your PAT"
                                   FontSize="11"
                                   Padding="6 4"
                                   Opacity="0.4"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock FontSize="10" Opacity="0.5" Margin="0 3 0 0" TextWrapping="Wrap">
                        <Hyperlink Click="OpenAdoPatPage_Click"
                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                            Learn how to create a personal access token
                        </Hyperlink>
                        <Run Text="with Code (read), Work Items (read), and Build (read) scopes."/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0 6 0 0" HorizontalAlignment="Left">
                        <Button Content="Save" Click="SaveAdoPat_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                FontSize="11"
                                MinWidth="0" MinHeight="0"
                                Padding="8 2"/>
                        <Button Content="Cancel" Click="CancelAdoPat_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                FontSize="11"
                                MinWidth="0" MinHeight="0"
                                Padding="8 2"
                                Margin="6 0 0 0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Manually add an Azure DevOps Server -->
                <TextBlock x:Name="AddAdoServerLink" FontSize="11" Margin="0 2 0 4">
                    <Hyperlink Click="ShowAddAdoServer_Click"
                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                        Add Azure DevOps Server...
                    </Hyperlink>
                </TextBlock>
                <StackPanel x:Name="AddAdoServerPanel" Visibility="Collapsed" Margin="0 0 0 4">
                    <TextBlock Text="Server URL or host (e.g. https://tfs.contoso.com)"
                               FontSize="10" Opacity="0.6" Margin="0 0 0 3"/>
                    <Grid Margin="0 0 0 4">
                        <TextBox x:Name="AddAdoServerUrlBox"
                                 FontSize="11"
                                 Padding="4 3"
                                 Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                                 Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                 BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                 KeyDown="AddAdoServerUrlBox_KeyDown"
                                 TextChanged="AddAdoServerUrlBox_TextChanged"/>
                        <TextBlock x:Name="AddAdoServerUrlPlaceholder"
                                   Text="https://tfs.contoso.com"
                                   FontSize="11"
                                   Padding="6 4"
                                   Opacity="0.4"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Personal access token"
                               FontSize="10" Opacity="0.6" Margin="0 0 0 3"/>
                    <Grid>
                        <PasswordBox x:Name="AddAdoServerPatBox"
                                     FontSize="11"
                                     Padding="4 3"
                                     Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                                     Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                     BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                     KeyDown="AddAdoServerPatBox_KeyDown"
                                     PasswordChanged="AddAdoServerPatBox_PasswordChanged"/>
                        <TextBlock x:Name="AddAdoServerPatPlaceholder"
                                   Text="Paste your PAT"
                                   FontSize="11"
                                   Padding="6 4"
                                   Opacity="0.4"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0 6 0 0" HorizontalAlignment="Left">
                        <Button Content="Add" Click="AddAdoServer_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                FontSize="11"
                                MinWidth="0" MinHeight="0"
                                Padding="8 2"/>
                        <Button Content="Cancel" Click="CancelAddAdoServer_Click"
                                Style="{DynamicResource ActionButtonStyle}"
                                FontSize="11"
                                MinWidth="0" MinHeight="0"
                                Padding="8 2"
                                Margin="6 0 0 0"/>
                    </StackPanel>
                </StackPanel>

                    </StackPanel>
                </Expander>

                <!-- Separator between accounts and preferences -->
                <Border BorderThickness="0 0 0 1"
                        BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarBorderBrushKey}}"
                        Margin="0 16 0 16"/>

                <!-- Search query section -->
                <Expander x:Name="SearchQueryOptions" Header="Incoming search query (GitHub)" IsExpanded="False"
                          FontSize="11" Margin="0 0 0 16">
                    <StackPanel Margin="18 10 0 0">
                <Grid>
                    <TextBox x:Name="SearchQueryTextBox"
                             FontSize="11"
                             Padding="4 3"
                             Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                             Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                             BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                             LostFocus="SearchQueryTextBox_LostFocus"
                             KeyDown="SearchQueryTextBox_KeyDown"
                             TextChanged="SearchQueryTextBox_TextChanged"/>
                    <TextBlock x:Name="SearchQueryPlaceholder"
                               Text="e.g. state:open archived:false (user:octocat OR org:MyOrg)"
                               FontSize="11"
                               Padding="6 4"
                               Opacity="0.4"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Filters incoming activity, not your personal work. Use {login} for your username. Leave empty for issues and PRs involving you. is:issue or is:pr is added automatically."
                           FontSize="10"
                           Opacity="0.5"
                           TextWrapping="Wrap"
                           Margin="0 8 0 0"/>
                    </StackPanel>
                </Expander>

                <!-- Display section -->
                <TextBlock Text="Display"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0 0 0 12"/>

                <Grid x:Name="DisplaySettingsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                <TextBlock Text="Initial keyboard focus"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0 0 16 12"/>
                <ComboBox x:Name="DefaultTabComboBox"
                          Grid.Column="1"
                          FontSize="11"
                          Padding="4 2"
                          Margin="0 0 0 12"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="DefaultTabComboBox_SelectionChanged"
                          Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                          Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                          BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}">
                    <ComboBoxItem Content="My work"/>
                    <ComboBoxItem Content="Incoming"/>
                </ComboBox>

                <TextBlock Text="Sort issues and pull requests by"
                           Grid.Row="1"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0 0 16 0"/>
                <ComboBox x:Name="SortOrderComboBox"
                          Grid.Row="1" Grid.Column="1"
                          FontSize="11"
                          Padding="4 2"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="SortOrderComboBox_SelectionChanged"
                          Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                          Background="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                          BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBorderBrushKey}}">
                    <ComboBoxItem Content="Most recent first"/>
                    <ComboBoxItem Content="GitHub first"/>
                    <ComboBoxItem Content="Azure DevOps first"/>
                </ComboBox>
                </Grid>
            </StackPanel>
            </Grid>
        </Border>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Not Connected State -->
        <StackPanel x:Name="NotConnectedPanel" Visibility="Collapsed">
            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.GoToSourceCode}"
                                Width="32" Height="32"
                                HorizontalAlignment="Left"
                                Margin="0 0 0 12"/>
            <TextBlock Text="Connect your accounts"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0 0 0 8"/>
            <TextBlock Text="Sign in to GitHub or Azure DevOps to see your pull requests, issues, and CI status here."
                       FontSize="13"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0 0 0 16"/>
            <TextBlock x:Name="ConnectGitHubTextBlock" FontSize="13" Margin="0 0 0 8">
                <Hyperlink x:Name="ConnectGitHubLink" Click="ConnectGitHub_Click"
                           Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                    Connect GitHub account...
                </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="GitHubCredentialHelpTextBlock"
                       Visibility="Collapsed"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0 0 0 12">
                <Run Text="GitHub sign-in uses Git Credential Manager, but it did not provide a credential. Sign in with Git Credential Manager or "/>
                <Hyperlink Click="ShowGitHubPatEntry_Click"
                           Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                    enter a GitHub token
                </Hyperlink>
                <Run Text="."/>
            </TextBlock>
            <TextBlock x:Name="ConnectAdoTextBlock" FontSize="13">
                <Hyperlink x:Name="ConnectAdoLink" Click="ConnectAdo_Click"
                           Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                    Connect Azure DevOps with Visual Studio account...
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Top">
            <ProgressBar IsIndeterminate="True"
                         Height="2"
                         Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                         Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                         BorderThickness="0"
                         Margin="0 0 0 12"/>
            <TextBlock x:Name="LoadingText"
                       Text="Loading your activity..."
                       FontSize="13"
                       Opacity="0.5"/>
        </StackPanel>

        <!-- Dashboard Content -->
        <DockPanel x:Name="DashboardPanel" Grid.Row="1">

            <TextBlock x:Name="ActivityWarningText" DockPanel.Dock="Top" Visibility="Collapsed"
                       Margin="8 0 0 8" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource {x:Static platformui:ProgressBarColors.IndicatorFillWarningBrushKey}}"/>

            <StackPanel x:Name="ActivityCoveragePanel" DockPanel.Dock="Bottom" Margin="8 10 0 0" Visibility="Collapsed">
                <WrapPanel>
                    <TextBlock x:Name="CoverageText" FontSize="11" Opacity="0.65" Margin="0 0 10 4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LoadMoreText" FontSize="11" Margin="0 0 0 4">
                        <Hyperlink x:Name="LoadMoreLink" Click="LoadMoreActivity_Click"
                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}">
                            <Run x:Name="LoadMoreLabel" Text="Load more"/>
                        </Hyperlink>
                    </TextBlock>
                </WrapPanel>
                <TextBlock x:Name="ActivityLoadStatus" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <Grid x:Name="WorkBlades">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MyWorkBlade" Grid.Column="0" Margin="0 0 24 0">
                    <TextBlock x:Name="WorkHeadingLine" FontSize="20" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Focusable="True" FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                               Margin="8 0 0 20" AutomationProperties.Name="My work">
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <TextBlock Text="My work" FontSize="20" FontWeight="SemiBold"/>
                        </InlineUIContainer>
                        <Run x:Name="MyWorkCount" FontSize="11"/>
                        <InlineUIContainer BaselineAlignment="Baseline">
                            <Border x:Name="CopilotActivityStatusGap" Width="12" Height="0"
                                    Tag="{Binding CopilotActivityStatus, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </InlineUIContainer>
                        <Run x:Name="CopilotActivityStatusText" BaselineAlignment="Baseline" FontWeight="Normal"
                             Text="{Binding CopilotActivityStatus, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                             FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                             ToolTip="{Binding CopilotActivityStatus, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}">
                            <Run.Foreground>
                                <SolidColorBrush Color="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextColorKey}}" Opacity="0.7"/>
                            </Run.Foreground>
                        </Run>
                    </TextBlock>
                    <DockPanel Margin="8 0 0 8" Visibility="{Binding HasSelectedMruItem, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button DockPanel.Dock="Right" Content="All repositories" Click="ClearFilter_Click"
                                Style="{DynamicResource ActionButtonStyle}" MinWidth="0" MinHeight="24" Padding="6 2"/>
                        <TextBlock Text="{Binding WorkSectionTitle}" FontSize="11" Opacity="0.65" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkSectionTitle}"/>
                    </DockPanel>
                    <StackPanel>
                        <WrapPanel Margin="8 0 0 6">
                            <RadioButton x:Name="MyWorkAllFilter" Content="All" GroupName="MyWorkKind" IsChecked="True"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <RadioButton x:Name="MyWorkPrFilter" Content="PRs" GroupName="MyWorkKind"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <RadioButton x:Name="MyWorkIssueFilter" Content="Issues" GroupName="MyWorkKind"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <RadioButton x:Name="MyWorkCopilotFilter" Content="Copilot" GroupName="MyWorkKind"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <RadioButton x:Name="MyWorkBuildFilter" Content="Builds" GroupName="MyWorkKind"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <CheckBox x:Name="MyWorkNeedsAttention" Content="Needs attention" Margin="8 3 0 6"
                                      Checked="ActivityFilter_Changed" Unchecked="ActivityFilter_Changed"
                                      ToolTip="Only show work with a known action for you to take."/>
                        </WrapPanel>
                        <ItemsControl x:Name="MyWorkList" Focusable="False" ItemTemplate="{StaticResource WorkItemTemplate}">
                            <ItemsControl.GroupStyle><StaticResource ResourceKey="WorkItemGroupStyle"/></ItemsControl.GroupStyle>
                        </ItemsControl>
                        <TextBlock x:Name="MyWorkEmpty" Text="No personal work in the loaded activity."
                                   TextWrapping="Wrap" Opacity="0.6" Margin="8 4 0 12"/>
                        <CheckBox x:Name="IncludeCompletedItems" Content="Include completed work (14 days)" FontSize="11" Margin="8 8 0 0"
                                  Checked="IncludeCompletedItems_Changed" Unchecked="IncludeCompletedItems_Changed"
                                  ToolTip="Include your merged PRs and completed issues/tasks from the last 14 days."/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="IncomingBlade" Grid.Column="1">
                    <TextBlock x:Name="IncomingHeading" FontSize="20" FontWeight="SemiBold" Focusable="True"
                               FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                               Margin="8 0 0 20" AutomationProperties.Name="Incoming">
                        <Run Text="Incoming"/>
                        <Run x:Name="IncomingCount" FontSize="11" FontWeight="Normal"/>
                    </TextBlock>
                    <StackPanel>
                        <WrapPanel Margin="8 0 0 6">
                            <RadioButton x:Name="IncomingAllFilter" Content="All" GroupName="IncomingKind" IsChecked="True"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <RadioButton x:Name="IncomingPrFilter" Content="PRs" GroupName="IncomingKind"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <RadioButton x:Name="IncomingIssueFilter" Content="Issues" GroupName="IncomingKind"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <RadioButton x:Name="IncomingBuildFilter" Content="Builds" GroupName="IncomingKind"
                                         Style="{StaticResource ActivityFilterStyle}" Checked="ActivityFilter_Changed"/>
                            <CheckBox x:Name="IncomingNeedsAttention" Content="Needs attention" Margin="8 3 0 6"
                                      Checked="ActivityFilter_Changed" Unchecked="ActivityFilter_Changed"
                                      ToolTip="Only show incoming items with a known action for you to take."/>
                        </WrapPanel>
                        <ItemsControl x:Name="IncomingList" Focusable="False" ItemTemplate="{StaticResource WorkItemTemplate}">
                            <ItemsControl.GroupStyle><StaticResource ResourceKey="WorkItemGroupStyle"/></ItemsControl.GroupStyle>
                        </ItemsControl>
                        <TextBlock x:Name="IncomingEmpty" Text="No incoming activity."
                                   TextWrapping="Wrap" Opacity="0.6" Margin="8 4 0 12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Error State -->
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
            <TextBlock Text="Something went wrong"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0 0 0 8"/>
            <TextBlock x:Name="ErrorMessageText"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Margin="0 0 0 12"/>
            <Button Click="Refresh_Click"
                    Style="{DynamicResource ActionButtonStyle}"
                    Padding="8 4"
                    BorderThickness="0"
                    Content="Try again"/>
        </StackPanel>
        </Grid>
        </StackPanel>
    </Grid>
</UserControl>
