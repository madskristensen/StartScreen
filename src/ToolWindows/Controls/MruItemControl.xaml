<UserControl x:Class="StartScreen.ToolWindows.Controls.MruItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:controls="clr-namespace:StartScreen.ToolWindows.Controls"
             xmlns:helpers="clr-namespace:StartScreen.Helpers"
             xmlns:typography="clr-namespace:StartScreen.ToolWindows"
             toolkit:Themes.UseVsTheme="True"
             Style="{DynamicResource StartScreen.Root}"
             Background="Transparent"
             Focusable="False"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="360">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../StartScreenResources.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <controls:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <controls:ExistsToTextDecorationsConverter x:Key="ExistsToTextDecorationsConverter"/>
        <controls:ExistsToOpacityConverter x:Key="ExistsToOpacityConverter"/>
        <Style x:Key="WorkspaceTagPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7 1"/>
            <Setter Property="Margin" Value="0 0 4 4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"/>
            <Setter Property="MaxWidth" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
            <Setter Property="Tag" Value="{DynamicResource {x:Static SystemParameters.HighContrastKey}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RepositoryLinkButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="16"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="typography:Typography.Role" Value="Metadata"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RepositoryCountButtonStyle" TargetType="Button" BasedOn="{StaticResource RepositoryLinkButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border x:Name="RootBorder"
            BorderThickness="0"
            Padding="8 12 5 12"
            MinHeight="48"
            Cursor="Hand"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            MouseEnter="RootBorder_MouseEnter"
            MouseLeave="RootBorder_MouseLeave"
            MouseUp="RootBorder_MouseUp"
            MouseRightButtonUp="RootBorder_MouseRightButtonUp"
            PreviewMouseRightButtonDown="RootBorder_PreviewMouseRightButtonDown"
            PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown"
            PreviewKeyDown="RootBorder_KeyDown"
            GotKeyboardFocus="RootBorder_GotKeyboardFocus"
            LostKeyboardFocus="RootBorder_LostKeyboardFocus">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource StartScreen.CardSurface}">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.ToolTip>
            <ToolTip Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolTipBrushKey}}"
                     Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolTipTextBrushKey}}"
                     BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolTipBorderBrushKey}}"
                     BorderThickness="1"
                     Padding="4">
                <StackPanel>
                    <!-- Last opened -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Last opened: " Opacity="0.7"/>
                        <TextBlock Text="{Binding FormattedDate}"/>
                    </StackPanel>

                    <!-- Git info section -->
                    <StackPanel Margin="0 2 0 0"
                                Visibility="{Binding HasGitBranch, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Branch -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Branch: " Opacity="0.7"/>
                            <TextBlock Text="{Binding GitBranch}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AheadBehindText}"
                                       Margin="6 0 0 0"
                                       Visibility="{Binding HasAheadBehind, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text=" &#x25CF;"
                                       Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                                       Style="{StaticResource StartScreen.Metadata}"
                                       ToolTip="Uncommitted changes"
                                       Visibility="{Binding HasUncommittedChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Last commit -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 2 0 0"
                                    Visibility="{Binding LastCommitTime, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBlock Text="Last commit: " Opacity="0.7"/>
                            <TextBlock Text="{Binding LastCommitTimeText}"/>
                        </StackPanel>

                        <!-- Stashes -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 2 0 0"
                                    Visibility="{Binding HasStashes, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Stashes: " Opacity="0.7"/>
                            <TextBlock Text="{Binding StashCount}"/>
                        </StackPanel>

                        <!-- Current operation -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0 2 0 0"
                                    Visibility="{Binding HasCurrentOperation, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Operation: " Opacity="0.7"/>
                            <TextBlock Text="{Binding CurrentOperation}" FontWeight="SemiBold"/>
                            <TextBlock Text=" in progress" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding CopilotChatTooltip}" Margin="0 4 0 0"
                               Visibility="{Binding HasCopilotChatSessions, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="{Binding BranchActivityTooltip}" Margin="0 4 0 0" MaxWidth="400" TextWrapping="Wrap"
                               Visibility="{Binding BranchActivityTooltip, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <TextBlock Text="{Binding VisitChangesTooltip}" Margin="0 4 0 0" MaxWidth="400" TextWrapping="Wrap"
                               Visibility="{Binding VisitChangesTooltip, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <TextBlock Text="{Binding WorktreeError}" Margin="0 4 0 0" MaxWidth="400" TextWrapping="Wrap"
                               Visibility="{Binding WorktreeError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <!-- Path -->
                    <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                        <TextBlock Text="Path: " Opacity="0.7"/>
                        <TextBlock Text="{Binding Path}"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </StackPanel>
                </StackPanel>
            </ToolTip>
        </Border.ToolTip>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <imaging:CrispImage x:Name="Icon" Width="20" Height="20" Margin="0 0 8 0" VerticalAlignment="Top"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameText" Text="{Binding Name}" Style="{StaticResource StartScreen.CardTitle}" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarTextActiveBrushKey}}"
                               TextTrimming="CharacterEllipsis"
                               TextDecorations="{Binding Exists, Converter={StaticResource ExistsToTextDecorationsConverter}}"
                               Opacity="{Binding Exists, Converter={StaticResource ExistsToOpacityConverter}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8 0 0 0" VerticalAlignment="Center"
                                ToolTip="{Binding GitBranch}"
                                Visibility="{Binding HasGitBranch, Converter={StaticResource BoolToVisibilityConverter}}">
                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.Branch}" Width="12" Height="12" Margin="0 0 4 0" Opacity="0.7"/>
                        <TextBlock Text="{Binding GitBranch}" Style="{StaticResource StartScreen.Metadata}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="72"/>
                    </StackPanel>
                    <Button x:Name="RepositoryPullRequestsButton" Grid.Column="2" Margin="8 0 0 0" VerticalAlignment="Center"
                            Style="{StaticResource RepositoryCountButtonStyle}" Click="RepositorySummary_Click"
                            ToolTip="{Binding RepositoryPullRequestsText}"
                            AutomationProperties.Name="{Binding RepositoryPullRequestsText}"
                            Visibility="{Binding HasOpenPullRequests, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Opacity="0.7">
                            <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.PullRequest}" Width="12" Height="12" Margin="0 0 4 0"/>
                            <TextBlock Text="{Binding RepositoryPullRequestCountText}" Style="{StaticResource StartScreen.Metadata}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PinButton" Grid.Column="3" Width="18" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                            Style="{StaticResource StartScreen.IconActionButton}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False"
                            HorizontalContentAlignment="Right" VerticalAlignment="Center" Margin="8 0 0 0"
                            ToolTip="Pin/Unpin" Click="PinButton_Click">
                        <imaging:CrispImage x:Name="PinIcon" Moniker="{x:Static catalog:KnownMonikers.Pin}" Width="16" Height="16"/>
                    </Button>
                </Grid>
                <ItemsControl x:Name="WorkspaceTagPills" Grid.Row="2" ItemsSource="{Binding Tags}" Margin="0 4 0 0" Focusable="False"
                              AutomationProperties.Name="Project tags"
                              Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WorkspaceTagPillStyle}" ToolTip="{Binding}">
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Style="{StaticResource StartScreen.Metadata}"
                                           Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid x:Name="RepositoryStatusRow" Grid.Row="1" Margin="0 3 0 0" ToolTip="{Binding RepositorySummaryTooltip}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRequestedReviews}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                <DataTrigger Binding="{Binding HasAdditionalWorktrees}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="{Binding RepositoryReviewsText}" Click="RepositoryReviews_Click"
                            ToolTip="Review requests for you" AutomationProperties.Name="Review requests for you"
                            Style="{StaticResource RepositoryLinkButtonStyle}"
                            Visibility="{Binding HasRequestedReviews, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <StackPanel x:Name="WorktreeIndicator" Grid.Column="1" Orientation="Horizontal" Margin="8 0 0 0" VerticalAlignment="Center"
                                ToolTip="{Binding WorktreeTooltip}" AutomationProperties.Name="{Binding WorktreeTooltip}"
                                Visibility="{Binding HasAdditionalWorktrees, Converter={StaticResource BoolToVisibilityConverter}}">
                        <imaging:CrispImage Moniker="{x:Static catalog:KnownMonikers.BranchFork}" Width="12" Height="12" Margin="0 0 4 0" Opacity="0.7"/>
                        <TextBlock Text="{Binding AdditionalWorktreeCount}" Style="{StaticResource StartScreen.Metadata}" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

    </Border>
</UserControl>
